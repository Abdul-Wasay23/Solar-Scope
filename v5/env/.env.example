# SolarScope Application Configuration
NEXT_PUBLIC_APP_NAME="SolarScope"
NEXT_PUBLIC_APP_DESCRIPTION="Solar System Planning, Estimation & Marketplace Ecosystem"

# Backend NestJS REST API Endpoint (Default planned: port 3001)
NEXT_PUBLIC_API_URL="http://localhost:3001/api"

# Map API Token (Mapbox / MapTiler / Location Service)
NEXT_PUBLIC_MAP_API_KEY=""

# OTP email delivery (Resend). Without these, development OTPs print to the server terminal.
RESEND_API_KEY=""
EMAIL_FROM="SolarScope <onboarding@your-domain.example>"

# Development-only Admin login. Never use public client-side NEXT_PUBLIC_ variables.
DEMO_ADMIN_EMAIL="admin@example.test"
DEMO_ADMIN_PASSWORD=""

# Google OAuth (server-side only; never use NEXT_PUBLIC_ for the client secret)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# Existing-account-only endpoint in the FastAPI backend. It must validate the
# Google ID token, match a previously linked Google subject, and return the
# existing SolarScope role and application JWT. It must never auto-register users.
GOOGLE_ACCOUNT_LOGIN_URL=""
